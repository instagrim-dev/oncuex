+def validate_export(export: dict) -> list[str]:
+    """Validate the documented export contract before a store accepts it."""
+    if not isinstance(export, dict):
+        return ["export: must be an object"]
+    allowed = {
+        "exportVersion",
+        "project",
+        "requirements",
+        "evidence",
+        "archivedEvidence",
+        "events",
+        "decisions",
