@@ -0,0 +1,433 @@
+import { useMemo, useState } from "react";
+import { ArrowRight, CheckCircle2, FileText, Loader2, Sparkles } from "lucide-react";
+
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Textarea } from "@/components/ui/textarea";
+import type { useOperatorSession } from "@/hooks/use-operator-session";
+import {
+  type AiRun,
+  type BriefProposal,
+  callOncuexAI,
+  validateBriefProposal,
+} from "@/lib/ai-client";
+import { BRIEF, SAMPLE_BRIEF_TEXT } from "@/oncuex/scenario";
+import { adoptReviewedBrief, attachBaselineEvidence } from "@/oncuex/demo";
+import type { Brief } from "@/oncuex/types";
+import { Chip, Note } from "./ui-bits";
+
+interface BriefReviewDialogProps {
+  session: ReturnType<typeof useOperatorSession>;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}
+
+const PROPOSAL_FIELDS = ["client", "project", "eventDate", "guestCount", "approvedBudget"];
+
+interface FormState {
+  client: string;
+  project: string;
+  eventDate: string;
+  guestCount: string;
+  budget: string;
+  timezone: string;
+  openQuestions: string;
+  circulationBuffer: string;
+  guestCountFixed: boolean;
+}
+
+const emptyForm: FormState = {
+  client: "",
+  project: "",
+  eventDate: "",
+  guestCount: "",
+  budget: "",
+  timezone: "America/Los_Angeles",
+  openQuestions: "",
+  circulationBuffer: "10",
+  guestCountFixed: true,
+};
+
+function fromProposal(proposal: BriefProposal): FormState {
+  return {
+    client: proposal.client ?? "",
+    project: proposal.project ?? "",
+    eventDate: proposal.eventDate ?? "",
+    guestCount: proposal.guestCount === null ? "" : String(proposal.guestCount),
+    budget:
+      proposal.approvedBudget === null
+        ? ""
+        : String(proposal.approvedBudget.minorUnits / 100),
+    timezone: proposal.timezone ?? "America/Los_Angeles",
+    openQuestions: proposal.openQuestions.join("\n"),
+    circulationBuffer: "10",
+    guestCountFixed: true,
+  };
+}
+
+export function BriefReviewDialog({
+  session,
+  open,
+  onOpenChange,
+}: BriefReviewDialogProps) {
+  const [proposal, setProposal] = useState<BriefProposal | null>(null);
+  const [mode, setMode] = useState<"ai" | "manual" | null>(null);
+  const [form, setForm] = useState<FormState>(emptyForm);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [run, setRun] = useState<AiRun | null>(null);
+  const [reviewedWithoutSpans, setReviewedWithoutSpans] = useState(false);
+
+  const missingSpans = useMemo(() => {
+    if (!proposal || mode !== "ai") return [];
+    const present = new Set(proposal.sourceSpans.map((span) => span.field));
+    return PROPOSAL_FIELDS.filter((field) => {
+      const value = proposal[field as keyof BriefProposal];
+      return value !== null && !present.has(field);
+    });
+  }, [proposal, mode]);
+
+  const missing = [
+    !form.client.trim() && "client",
+    !form.project.trim() && "project",
+    !form.eventDate && "date",
+    !form.guestCount && "guest count",
+    !form.budget && "budget",
+    !form.timezone.trim() && "timezone",
+  ].filter(Boolean) as string[];
+
+  const canAdopt =
+    missing.length === 0 &&
+    (mode === "manual" || missingSpans.length === 0 || reviewedWithoutSpans);
+
+  const update = (key: keyof FormState, value: string) => {
+    setForm((current) => ({ ...current, [key]: value }));
+  };
+
+  const extract = async () => {
+    setLoading(true);
+    setError(null);
+    const result = await callOncuexAI<BriefProposal>("extract_brief", {
+      briefText: SAMPLE_BRIEF_TEXT,
+    });
+    setLoading(false);
+    if (!result.ok) {
+      setError(result.error);
+      setRun(result.run);
+      return;
+    }
+    const valid = validateBriefProposal(result.data);
+    if (!valid.ok) {
+      setError(valid.error);
+      setRun(result.run);
+      return;
+    }
+    setProposal(valid.proposal);
+    setForm(fromProposal(valid.proposal));
+    setMode("ai");
+    setRun(result.run);
+    setReviewedWithoutSpans(false);
+  };
+
+  const useManualSample = () => {
+    const manual: BriefProposal = {
+      client: BRIEF.client,
+      project: BRIEF.project,
+      eventDate: BRIEF.eventDate,
+      guestCount: BRIEF.guestCount,
+      approvedBudget: BRIEF.approvedBudget,
+      timezone: BRIEF.timezone,
+      openQuestions: BRIEF.openQuestions,
+      sourceSpans: [],
+      uncertainties: ["Manual sample values, not a model extraction."],
+      questions: [],
+    };
+    setProposal(manual);
+    setForm(fromProposal(manual));
+    setMode("manual");
+    setRun(null);
+    setError(null);
+    setReviewedWithoutSpans(true);
+  };
+
+  const adopt = () => {
+    const budget = Number(form.budget);
+    const guests = Number(form.guestCount);
+    const buffer = Number(form.circulationBuffer);
+    const brief: Brief = {
+      client: form.client.trim(),
+      project: form.project.trim(),
+      guestCount: guests,
+      guestCountIsFixed: form.guestCountFixed,
+      eventDate: form.eventDate,
+      timezone: form.timezone.trim(),
+      approvedBudget: {
+        currency: proposal?.approvedBudget?.currency ?? BRIEF.approvedBudget.currency,
+        minorUnits: Math.round(budget * 100),
+      },
+      owner: BRIEF.owner,
+      openQuestions: form.openQuestions
+        .split("\n")
+        .map((question) => question.trim())
+        .filter(Boolean),
+      circulationBuffer: Number.isFinite(buffer) ? buffer : 10,
+    };
+    session.apply("Brief adopted", (current) => {
+      adoptReviewedBrief(current, brief);
+      attachBaselineEvidence(current);
+      return "The brief is adopted and the prepared sample documents are attached.";
+    });
+    onOpenChange(false);
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-h-[90vh] max-w-2xl overflow-y-auto">
+        <DialogHeader>
+          <DialogTitle className="flex items-center gap-2">
+            <FileText className="size-4" aria-hidden />
+            Review the client brief
+          </DialogTitle>
+          <DialogDescription>
+            Extract the facts from the brief, check every value against its source, then adopt
+            the brief. The proposal is not project data until you adopt it.
+          </DialogDescription>
+        </DialogHeader>
+
+        <div className="space-y-3">
+          <div className="rounded-lg border border-border/60 bg-muted/30 p-3 text-[12px] leading-5">
+            {SAMPLE_BRIEF_TEXT}
+          </div>
+
+          <div className="flex flex-wrap items-center gap-2">
+            <Button size="sm" className="gap-1.5" onClick={extract} disabled={loading}>
+              {loading ? (
+                <Loader2 className="size-3.5 animate-spin" />
+              ) : (
+                <Sparkles className="size-3.5" />
+              )}
+              {mode === "ai" ? "Extract again" : "Extract with AI"}
+            </Button>
+            {mode === "ai" && <Chip tone="success">AI proposal</Chip>}
+            {mode === "manual" && <Chip tone="neutral">Manual sample</Chip>}
+            <Button size="sm" variant="ghost" onClick={useManualSample} disabled={loading}>
+              Use the prepared sample manually
+            </Button>
+          </div>
+
+          {run && (
+            <p className="text-[10.5px] text-muted-foreground">
+              AI response · {run.durationMs} ms ·{" "}
+              {run.responseId ? `reference ${run.responseId}` : run.detail}
+            </p>
+          )}
+
+          {error && (
+            <Note tone="danger" icon={FileText}>
+              <span className="font-medium">AI extraction unavailable.</span> {error} You can enter
+              the brief manually or use the prepared sample, clearly labelled.
+            </Note>
+          )}
+
+          {proposal && (
+            <div className="space-y-3">
+              <div className="grid gap-3 sm:grid-cols-2">
+                <div className="space-y-1">
+                  <Label htmlFor="brief-client">Client</Label>
+                  <Input
+                    id="brief-client"
+                    value={form.client}
+                    onChange={(event) => update("client", event.target.value)}
+                    placeholder="Not stated — enter manually"
+                  />
+                </div>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-project">Event</Label>
+                  <Input
+                    id="brief-project"
+                    value={form.project}
+                    onChange={(event) => update("project", event.target.value)}
+                    placeholder="Not stated — enter manually"
+                  />
+                </div>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-date">Date</Label>
+                  <Input
+                    id="brief-date"
+                    type="date"
+                    value={form.eventDate}
+                    onChange={(event) => update("eventDate", event.target.value)}
+                  />
+                </div>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-guests">Guests</Label>
+                  <Input
+                    id="brief-guests"
+                    type="number"
+                    min={1}
+                    value={form.guestCount}
+                    onChange={(event) => update("guestCount", event.target.value)}
+                  />
+                </div>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-budget">Approved budget (USD)</Label>
+                  <Input
+                    id="brief-budget"
+                    type="number"
+                    min={0}
+                    step="0.01"
+                    value={form.budget}
+                    onChange={(event) => update("budget", event.target.value)}
+                  />
+                </div>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-timezone">Timezone</Label>
+                  <Input
+                    id="brief-timezone"
+                    value={form.timezone}
+                    onChange={(event) => update("timezone", event.target.value)}
+                  />
+                  <p className="text-[10px] text-muted-foreground">
+                    Internal setting, not extracted from the brief.
+                  </p>
+                </div>
+              </div>
+
+              <div className="space-y-1">
+                <Label htmlFor="brief-questions">Open questions</Label>
+                <Textarea
+                  id="brief-questions"
+                  rows={3}
+                  value={form.openQuestions}
+                  onChange={(event) => update("openQuestions", event.target.value)}
+                  placeholder="One question per line"
+                />
+              </div>
+
+              <div className="grid gap-3 sm:grid-cols-2">
+                <label className="flex items-center gap-2 self-end text-[11px]">
+                  <input
+                    type="checkbox"
+                    checked={form.guestCountFixed}
+                    onChange={(event) =>
+                      setForm((current) => ({ ...current, guestCountFixed: event.target.checked }))
+                    }
+                  />
+                  Guest count is fixed (internal assumption)
+                </label>
+                <div className="space-y-1">
+                  <Label htmlFor="brief-buffer">Circulation buffer</Label>
+                  <Input
+                    id="brief-buffer"
+                    type="number"
+                    min={0}
+                    value={form.circulationBuffer}
+                    onChange={(event) => update("circulationBuffer", event.target.value)}
+                  />
+                  <p className="text-[10px] text-muted-foreground">Internal planning setting.</p>
+                </div>
+                <p className="self-end text-[10.5px] text-muted-foreground">
+                  Event lead {BRIEF.owner.name} · fixed sample role, not extracted.
+                </p>
+              </div>
+
+              {proposal.uncertainties.length > 0 && (
+                <div className="rounded-lg border border-warning/25 bg-warning/5 px-3 py-2">
+                  <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-warning">
+                    Uncertainties
+                  </p>
+                  <ul className="mt-0.5 space-y-0.5">
+                    {proposal.uncertainties.map((entry) => (
+                      <li key={entry} className="text-[11px] leading-5 text-muted-foreground">
+                        {entry}
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              )}
+
+              {proposal.questions.length > 0 && (
+                <div className="rounded-lg border border-border/60 px-3 py-2">
+                  <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+                    Questions to confirm
+                  </p>
+                  <ul className="mt-0.5 space-y-0.5">
+                    {proposal.questions.map((entry) => (
+                      <li key={entry} className="text-[11px] leading-5 text-muted-foreground">
+                        {entry}
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              )}
+
+              {proposal.sourceSpans.length > 0 && (
+                <div className="space-y-1">
+                  <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+                    Source spans
+                  </p>
+                  <ul className="space-y-1">
+                    {proposal.sourceSpans.map((span) => (
+                      <li key={`${span.field}-${span.quote}`} className="text-[11px] leading-5">
+                        <span className="font-mono text-[10px] text-muted-foreground">
+                          {span.field}
+                        </span>{" "}
+                        “{span.quote}”
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              )}
+
+              {missingSpans.length > 0 && (
+                <label className="flex items-start gap-2 rounded-lg border border-warning/25 bg-warning/5 px-3 py-2 text-[11px] leading-5">
+                  <input
+                    type="checkbox"
+                    checked={reviewedWithoutSpans}
+                    onChange={(event) => setReviewedWithoutSpans(event.target.checked)}
+                    className="mt-0.5"
+                  />
+                  <span>
+                    I reviewed the values without a supporting quote ({missingSpans.join(", ")})
+                    and corrected anything that was not stated.
+                  </span>
+                </label>
+              )}
+
+              {missing.length > 0 && (
+                <p className="text-[11px] text-warning">
+                  Complete the missing fields before adopting: {missing.join(", ")}.
+                </p>
+              )}
+
+              <Note tone="neutral" icon={CheckCircle2}>
+                Adopting the brief and adding the prepared sample documents uses the same commands
+                as the rest of the binder. The documents are prepared sample files, not live
+                partner confirmations.
+              </Note>
+            </div>
+          )}
+        </div>
+
+        <DialogFooter>
+          <Button variant="outline" size="sm" onClick={() => onOpenChange(false)}>
+            Cancel
+          </Button>
+          <Button size="sm" className="gap-1.5" disabled={!proposal || !canAdopt} onClick={adopt}>
+            Adopt brief and add sample documents
+            <ArrowRight className="size-3.5" />
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/app/src/components/oncuex/budget-view.tsx b/app/src/components/oncuex/budget-view.tsx
new file mode 100644
--- /dev/null
+++ b/app/src/components/oncuex/budget-view.tsx
@@ -0,0 +1,224 @@
+import { Button } from "@/components/ui/button";
+import type { useOperatorSession } from "@/hooks/use-operator-session";
+import { PM_ACTOR, reviewEvidence } from "@/oncuex/demo";
+import { BRIEF, sourceAttribution } from "@/oncuex/scenario";
+import { formatDate, formatMoney } from "@/oncuex/format";
+import { sourceState, sourceStateLabel } from "@/oncuex/presentation";
+import type { Brief, EvidenceRecord } from "@/oncuex/types";
+import { AlertTriangle, Wallet } from "lucide-react";
+import { cn } from "@/lib/utils";
+import { Chip, EmptyState, Panel } from "./ui-bits";
+
+interface BudgetViewProps {
+  session: ReturnType<typeof useOperatorSession>;
+  onStartSample: () => void;
+  onOpenTab: (tab: string) => void;
+}
+
+const CATEGORY_LABELS: Record<string, string> = {
+  venue: "Venue",
+  catering: "Catering",
+  production: "Production",
+  photography: "Photography",
+};
+
+export function BudgetView({ session, onStartSample, onOpenTab }: BudgetViewProps) {
+  const store = session.store;
+  const snapshot = store.snapshot();
+  const briefReady = Boolean((snapshot.brief as { client?: string }).client);
+  const brief: Brief = briefReady ? (snapshot.brief as Brief) : BRIEF;
+
+  if (!briefReady) {
+    return (
+      <Panel eyebrow="Budget" title="The budget comes with the brief">
+        <EmptyState
+          icon={Wallet}
+          title="No budget yet"
+          description="Start the sample event to bring in the approved Northwind budget and the partner commitments."
+          action={
+            <Button size="sm" onClick={onStartSample}>
+              Start with the sample event
+            </Button>
+          }
+        />
+      </Panel>
+    );
+  }
+
+  const currency = snapshot.budget.committedTotal.currency || brief.approvedBudget.currency;
+  const approved = brief.approvedBudget.minorUnits;
+  const committed = snapshot.budget.committedTotal.minorUnits;
+  const delta = committed - approved;
+  const progress = approved ? Math.min(100, Math.round((committed / approved) * 100)) : 0;
+  const budgetDocuments = store.evidence.filter(
+    (record) => record.requirementId === "REQ-budget-total-1",
+  );
+
+  const review = (record: EvidenceRecord, disposition: "accepted" | "rejected") => {
+    session.apply(sourceAttribution(record), (current) => {
+      reviewEvidence(current, record.id, disposition, "project_manager", PM_ACTOR);
+      return disposition === "accepted"
+        ? "The budget document is reviewed and current."
+        : "The budget document is marked as needing a new version. No message was sent.";
+    });
+  };
+
+  return (
+    <div className="space-y-4">
+      <Panel
+        eyebrow="Budget"
+        title={`${formatMoney(approved, currency)} approved`}
+        description="What the launch is committed to, by partner. If the plan moves, the committed total moves with it."
+        actions={
+          <Chip tone={delta > 0 ? "warning" : "success"}>
+            {delta > 0 ? "Over budget" : "Inside budget"}
+          </Chip>
+        }
+      >
+        <div className="grid gap-3 sm:grid-cols-3">
+          <div className="rounded-lg border border-border/60 p-3">
+            <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+              Approved
+            </p>
+            <p className="tnum mt-1 text-xl font-semibold">{formatMoney(approved, currency)}</p>
+          </div>
+          <div className="rounded-lg border border-border/60 p-3">
+            <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+              Committed
+            </p>
+            <p className="tnum mt-1 text-xl font-semibold">{formatMoney(committed, currency)}</p>
+          </div>
+          <div className="rounded-lg border border-border/60 p-3">
+            <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+              {delta > 0 ? "Over" : "Remaining"}
+            </p>
+            <p
+              className={cn(
+                "tnum mt-1 text-xl font-semibold",
+                delta > 0 ? "text-warning" : "text-success",
+              )}
+            >
+              {formatMoney(Math.abs(delta), currency)}
+            </p>
+          </div>
+        </div>
+
+        <div className="mt-3 h-2 overflow-hidden rounded-full bg-muted">
+          <div
+            className={cn("h-full rounded-full", delta > 0 ? "bg-warning" : "bg-primary")}
+            style={{ width: `${progress}%` }}
+          />
+        </div>
+
+        {delta > 0 && (
+          <p
+            id="budget-overage"
+            className="mt-2 flex items-start gap-1.5 rounded-lg border border-warning/25 bg-warning/5 px-3 py-2 text-[11.5px] leading-5 text-warning"
+          >
+            <AlertTriangle className="mt-0.5 size-3.5 shrink-0" aria-hidden />
+            Committed {formatMoney(committed, currency)} is {formatMoney(delta, currency)} over the{" "}
+            {formatMoney(approved, currency)} approved budget.
+          </p>
+        )}
+
+        <div className="mt-4 space-y-1.5">
+          <p className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
+            Commitments
+          </p>
+          <ul className="space-y-1">
+            {snapshot.budget.commitments.map((commitment) => (
+              <li
+                key={`${commitment.vendor}-${commitment.category}`}
+                className="flex flex-wrap items-center justify-between gap-2 border-b border-border/50 py-1.5 last:border-0"
+              >
+                <div className="min-w-0">
+                  <p className="text-[12px] font-medium">{commitment.vendor}</p>
+                  <p className="text-[10.5px] text-muted-foreground">
+                    {CATEGORY_LABELS[commitment.category] ?? commitment.category}
+                  </p>
+                </div>
+                <p className="tnum text-[12.5px] font-medium">
+                  {formatMoney(commitment.amount.minorUnits, commitment.amount.currency)}
+                </p>
+              </li>
+            ))}
+          </ul>
+        </div>
+      </Panel>
+
+      <Panel
+        eyebrow="Budget document"
+        title="The sheet behind the numbers"
+        description="The finance reconciliation behind the committed total."
+      >
+        {budgetDocuments.length === 0 ? (
+          <p className="text-[12px] text-muted-foreground">
+            No budget document is attached. The brief's approved budget is shown above.
+          </p>
+        ) : (
+          <ul className="space-y-2">
+            {budgetDocuments.map((record) => {
+              const state = sourceState(record, snapshot, store.now());
+              return (
+                <li key={record.id} className="rounded-lg border border-border/60 px-3 py-2">
+                  <div className="flex flex-wrap items-center justify-between gap-2">
+                    <p className="text-[12px] font-medium">{sourceAttribution(record)}</p>
+                    <div className="flex items-center gap-1">
+                      <Chip tone={state === "confirmed" ? "success" : "warning"}>
+                        {sourceStateLabel(state)}
+                      </Chip>
+                      {state === "review" && (
+                        <Button
+                          size="sm"
+                          className="h-6 px-2 text-[10px]"
+                          onClick={() => review(record, "accepted")}
+                        >
+                          Mark reviewed
+                        </Button>
+                      )}
+                      {state === "update" && (
+                        <Button
+                          size="sm"
+                          variant="outline"
+                          className="h-6 px-2 text-[10px]"
+                          onClick={() => review(record, "rejected")}
+                        >
+                          Mark for a new version
+                        </Button>
+                      )}
+                      {state === "confirmed" && (
+                        <Button
+                          size="sm"
+                          variant="ghost"
+                          className="h-6 px-2 text-[10px]"
+                          onClick={() => review(record, "rejected")}
+                        >
+                          Not used
+                        </Button>
+                      )}
+                    </div>
+                  </div>
+                  <p className="mt-1 text-[11.5px] italic leading-5 text-muted-foreground">
+                    “{record.sourceExcerpt}”
+                  </p>
+                  <p className="mt-1 text-[10.5px] text-muted-foreground">
+                    Received {formatDate(record.observedAt)} · valid to{" "}
+                    {formatDate(record.expiresAt)}
+                  </p>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+        <Button
+          size="sm"
+          variant="ghost"
+          className="mt-2 h-8 px-2 text-[11.5px]"
+          onClick={() => onOpenTab("partners")}
+        >
+          See the partner commitments
+        </Button>
+      </Panel>
+    </div>
+  );
+}
diff --git a/app/src/components/oncuex/checklist-view.tsx b/app/src/components/oncuex/checklist-view.tsx
new file mode 100644
--- /dev/null
+++ b/app/src/components/oncuex/checklist-view.tsx
@@ -0,0 +1,236 @@
+import { Button } from "@/components/ui/button";
+import type { useOperatorSession } from "@/hooks/use-operator-session";
+import { BRIEF, PEOPLE, REQUIREMENTS, sourceAttribution } from "@/oncuex/scenario";
+import { WORK_AREAS } from "@/oncuex/work-areas";
+import { formatDate, residualText } from "@/oncuex/format";
+import {
+  checklistState,
+  requirementNote,
+  sourceState,
+  sourceStateLabel,
+} from "@/oncuex/presentation";
+import type { Assessment, Brief } from "@/oncuex/types";
+import {
+  ArrowRight,
+  Circle,
+  Clock3,
+  FileCheck2,
+  ListChecks,
+  RefreshCw,
+} from "lucide-react";
+import { cn } from "@/lib/utils";
+import { EmptyState, Panel } from "./ui-bits";
+
+interface ChecklistViewProps {
+  session: ReturnType<typeof useOperatorSession>;
+  assessment: Assessment | null;
+  onStartSample: () => void;
+  onOpenTab: (tab: string) => void;
+}
+
+export function ChecklistView({
+  session,
+  assessment,
+  onStartSample,
+  onOpenTab,
+}: ChecklistViewProps) {
+  const store = session.store;
+  const snapshot = store.snapshot();
+  const briefReady = Boolean((snapshot.brief as { client?: string }).client);
+  const brief: Brief = briefReady ? (snapshot.brief as Brief) : BRIEF;
+
+  if (!briefReady) {
+    return (
+      <Panel eyebrow="Checklist" title="The checklist starts with the event">
+        <EmptyState
+          icon={ListChecks}
+          title="No plan yet"
+          description="Start the sample event to bring in the Northwind checklist, its partners and the documents behind each piece of work."
+          action={
+            <Button size="sm" onClick={onStartSample}>
+              Start with the sample event
+            </Button>
+          }
+        />
+      </Panel>
+    );
+  }
+
+  if (!assessment) {
+    return (
+      <Panel eyebrow="Checklist" title="The checklist could not be read">
+        <p className="text-[12.5px] text-muted-foreground">
+          Reload the sample plan from the Settings menu.
+        </p>
+      </Panel>
+    );
+  }
+
+  const results = new Map(
+    assessment.requirements.map((result) => [result.requirementId, result]),
+  );
+  const total = assessment.requirements.length;
+  const done = assessment.requirements.filter((result) => result.status === "supported").length;
+  const progress = total ? Math.round((done / total) * 100) : 0;
+
+  return (
+    <div className="space-y-4">
+      <Panel
+        id="checklist-support"
+        eyebrow="Checklist"
+        title="The work behind the launch"
+        description="The work the launch needs, grouped by work area. A row shows whether its supporting checks pass, not whether the real-world task is complete. Open a row for its documents and findings."
+        actions={
+          <span className="text-[11.5px] text-muted-foreground">
+            {done} of {total} supporting checks pass
+          </span>
+        }
+      >
+        <div className="h-1.5 overflow-hidden rounded-full bg-muted">
+          <div
+            className={cn(
+              "h-full rounded-full transition-all",
+              progress === 100 ? "bg-success" : "bg-primary",
+            )}
+            style={{ width: `${progress}%` }}
+          />
+        </div>
+
+        <div className="mt-4 space-y-5">
+          {WORK_AREAS.map((area) => {
+            const areaRequirements = area.requirementIds
+              .map((id) => REQUIREMENTS.find((requirement) => requirement.id === id))
+              .filter((requirement): requirement is (typeof REQUIREMENTS)[number] => Boolean(requirement));
+            const areaDone = areaRequirements.filter(
+              (requirement) => results.get(requirement.id)?.status === "supported",
+            ).length;
+
+            return (
+              <section key={area.id} className="space-y-2">
+                <div className="flex items-center justify-between gap-2 border-b border-border/60 pb-1">
+                  <h3 className="text-[14px] font-semibold">{area.label}</h3>
+                  <span className="text-[10.5px] uppercase tracking-[0.12em] text-muted-foreground">
+                    {areaDone}/{areaRequirements.length} supporting checks
+                  </span>
+                </div>
+
+                <ul className="space-y-1.5">
+                  {areaRequirements.map((requirement) => {
+                    const result = results.get(requirement.id);
+                    const state = checklistState(result);
+                    const contextNote = requirementNote(requirement.id, snapshot, brief);
+                    const findings = (result?.residuals ?? [])
+                      .map((residual) => residualText(residual))
+                      .filter(
+                        (finding) =>
+                          finding !== contextNote &&
+                          !(contextNote && finding.includes("current plan values")),
+                      );
+                    const allFindings = [contextNote, ...findings].filter(
+                      (finding): finding is string => Boolean(finding),
+                    );
+                    const documents = store.evidence.filter(
+                      (record) => record.requirementId === requirement.id,
+                    );
+                    const currentDocuments = documents.filter(
+                      (record) => sourceState(record, snapshot, store.now()) !== "unused",
+                    );
+                    return (
+                      <li
+                        key={requirement.id}
+                        className="flex gap-2.5 rounded-lg border border-border/60 bg-card px-3 py-2.5"
+                      >
+                        <span className="mt-0.5 shrink-0" aria-hidden>
+                          {state.tone === "done" ? (
+                            <FileCheck2 className="size-4 text-success" />
+                          ) : state.tone === "waiting" ? (
+                            <Clock3 className="size-4 text-warning" />
+                          ) : state.tone === "needs" ? (
+                            <RefreshCw className="size-4 text-warning" />
+                          ) : (
+                            <Circle className="size-4 text-muted-foreground/60" />
+                          )}
+                        </span>
+
+                        <div className="min-w-0 flex-1">
+                          <div className="flex flex-wrap items-start justify-between gap-x-3 gap-y-0.5">
+                            <p className="text-[12.5px] font-medium leading-5">
+                              {requirement.label}
+                            </p>
+                            <span
+                              className={cn(
+                                "text-[10.5px] font-medium",
+                                state.tone === "done"
+                                  ? "text-success"
+                                  : state.tone === "needs" || state.tone === "waiting"
+                                    ? "text-warning"
+                                    : "text-muted-foreground",
+                              )}
+                            >
+                              {state.label}
+                            </span>
+                          </div>
+                          <p className="text-[11px] text-muted-foreground">
+                            {PEOPLE[requirement.owner] ?? "Unassigned"}
+                          </p>
+                          {allFindings.length > 0 && (
+                            <ul className="mt-0.5 space-y-0.5">
+                              {allFindings.map((finding) => (
+                                <li
+                                  key={finding}
+                                  className="text-[11px] leading-5 text-muted-foreground"
+                                >
+                                  {finding}
+                                </li>
+                              ))}
+                            </ul>
+                          )}
+
+                          <div className="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10.5px] text-muted-foreground">
+                            {currentDocuments.length === 0 ? (
+                              <span>No document yet</span>
+                            ) : (
+                              currentDocuments.map((record) => {
+                                const source = sourceState(record, snapshot, store.now());
+                                return (
+                                  <span key={record.id}>
+                                    {sourceAttribution(record)}
+                                    {source === "confirmed"
+                                      ? ` · reviewed and current · valid to ${formatDate(record.expiresAt)}`
+                                      : ` · ${sourceStateLabel(source).toLowerCase()}`}
+                                  </span>
+                                );
+                              })
+                            )}
+                          </div>
+                        </div>
+
+                        <button
+                          type="button"
+                          onClick={() => onOpenTab("partners")}
+                          className="mt-0.5 self-start text-[10.5px] text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
+                        >
+                          Documents
+                        </button>
+                      </li>
+                    );
+                  })}
+                </ul>
+              </section>
+            );
+          })}
+        </div>
+
+        <div className="mt-4 flex flex-wrap gap-2 border-t border-border/60 pt-3">
+          <Button size="sm" variant="outline" onClick={() => onOpenTab("partners")}>
+            Open the partners
+            <ArrowRight className="size-3.5" />
+          </Button>
+          <Button size="sm" variant="ghost" onClick={() => onOpenTab("timeline")}>
+            See the day timeline
+          </Button>
+        </div>
+      </Panel>
+    </div>
+  );
+}
diff --git a/app/src/components/oncuex/client-update-dialog.tsx b/app/src/components/oncuex/client-update-dialog.tsx
new file mode 100644
--- /dev/null
+++ b/app/src/components/oncuex/client-update-dialog.tsx
@@ -0,0 +1,291 @@
+import { useMemo, useState } from "react";
+import { Copy, Download, Loader2, Sparkles } from "lucide-react";
+
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { Textarea } from "@/components/ui/textarea";
+import type { useOperatorSession } from "@/hooks/use-operator-session";
+import { type AiRun, callOncuexAI } from "@/lib/ai-client";
+import { BRIEF, PEOPLE, REQUIREMENTS } from "@/oncuex/scenario";
+import { WORK_AREAS } from "@/oncuex/work-areas";
+import { formatDate, formatMoney, residualText } from "@/oncuex/format";
+import { checklistState, planExceptions, sourceState } from "@/oncuex/presentation";
+import type { Assessment, Brief } from "@/oncuex/types";
+import { Chip, Note } from "./ui-bits";
+
+interface ClientUpdateDialogProps {
+  session: ReturnType<typeof useOperatorSession>;
+  assessment: Assessment | null;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}
+
+export function ClientUpdateDialog({
+  session,
+  assessment,
+  open,
+  onOpenChange,
+}: ClientUpdateDialogProps) {
+  const [draft, setDraft] = useState("");
+  const [mode, setMode] = useState<"ai" | "manual" | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [run, setRun] = useState<AiRun | null>(null);
+  const [copied, setCopied] = useState(false);
+
+  const store = session.store;
+  const snapshot = store.snapshot();
+  const briefReady = Boolean((snapshot.brief as { client?: string }).client);
+  const brief: Brief = briefReady ? (snapshot.brief as Brief) : BRIEF;
+  const latest = store.latestDecision();
+  const latestCurrent = latest ? store.currentness(latest.id) === "current" : false;
+  const exceptions = briefReady && assessment
+    ? planExceptions(snapshot, brief, assessment)
+    : [];
+  const documentsNeedingUpdate = store.evidence.filter(
+    (record) => sourceState(record, snapshot, store.now()) === "update",
+  ).length;
+
+  const draftWarnings = useMemo(() => {
+    const warnings: string[] = [];
+    const lower = draft.toLowerCase();
+    if (
+      !latestCurrent &&
+      (/\b(is|has been|remains|was)\s+(signed off|approved)\b/.test(lower) ||
+        /\bapproval\s+(is|remains)\b/.test(lower))
+    ) {
+      warnings.push("The draft claims a sign-off or approval that is not current.");
+    }
+    if (
+      /\b(confirmed by|has confirmed|partner confirmed|vendor confirmed|venue confirmed|confirmed the venue|confirmed the partner)\b/.test(
+        lower,
+      )
+    ) {
+      warnings.push("The draft claims a partner confirmation.");
+    }
+    if (/\b(booked|reserved|held for you|available|availability)\b/.test(lower)) {
+      warnings.push("The draft claims availability or a booking.");
+    }
+    return warnings;
+  }, [draft, latestCurrent]);
+
+  const projectState = {
+    event: {
+      client: brief.client,
+      project: brief.project,
+      date: brief.eventDate,
+      timezone: brief.timezone,
+      guests: brief.guestCount,
+      venue: snapshot.location.venueName,
+      approvedBudget: formatMoney(brief.approvedBudget.minorUnits, brief.approvedBudget.currency),
+      committed: formatMoney(
+        snapshot.budget.committedTotal.minorUnits,
+        snapshot.budget.committedTotal.currency,
+      ),
+    },
+    checklist: WORK_AREAS.map((area) => ({
+      area: area.label,
+      items: area.requirementIds
+        .map((id) => REQUIREMENTS.find((requirement) => requirement.id === id))
+        .filter(Boolean)
+        .map((requirement) => {
+          const result = assessment?.requirements.find(
+            (candidate) => candidate.requirementId === requirement?.id,
+          );
+          const support = result ? checklistState(result) : null;
+          return {
+            task: requirement?.label,
+            owner: requirement ? PEOPLE[requirement.owner] ?? "Unassigned" : "Unassigned",
+            state: support
+              ? {
+                  status: support.label,
+                  finding: support.detail,
+                }
+              : { status: "Not assessed", finding: "" },
+          };
+        }),
+    })),
+    exceptions: exceptions.map((exception) => `${exception.title}: ${exception.detail}`),
+    openQuestions: brief.openQuestions,
+    signOff: latest
+      ? {
+          status: latestCurrent
+            ? "signed off and still applies"
+            : "an earlier sign-off no longer applies to this version",
+          by: PEOPLE[latest.actor] ?? "the event lead",
+        }
+      : "not signed off",
+    documentsNeedingUpdate,
+  };
+
+  const generate = async () => {
+    if (!briefReady) return;
+    setLoading(true);
+    setError(null);
+    const result = await callOncuexAI<{ draft: string }>("draft_update", {
+      project: projectState,
+    });
+    setLoading(false);
+    setRun(result.run);
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+    setDraft(result.data.draft);
+    setMode("ai");
+  };
+
+  const download = () => {
+    if (!draft.trim() || draftWarnings.length > 0) return;
+    const blob = new Blob([draft], { type: "text/markdown" });
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement("a");
+    anchor.href = url;
+    anchor.download = "northwind-client-update.md";
+    document.body.appendChild(anchor);
+    anchor.click();
+    anchor.remove();
+    URL.revokeObjectURL(url);
+  };
+
+  const copy = async () => {
+    if (draftWarnings.length > 0) return;
+    try {
+      await navigator.clipboard.writeText(draft);
+      setCopied(true);
+      window.setTimeout(() => setCopied(false), 1800);
+    } catch {
+      setError("The draft could not be copied. Select the text and copy it manually.");
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-h-[90vh] max-w-2xl overflow-y-auto">
+        <DialogHeader>
+          <DialogTitle>Client update</DialogTitle>
+          <DialogDescription>
+            A draft for the event lead to review and edit. It is not sent from OnCueX, and it is
+            not authoritative until you share it yourself.
+          </DialogDescription>
+        </DialogHeader>
+
+        {!briefReady || !assessment ? (
+          <Note tone="warning">
+            Review the client brief and assess the plan before drafting an update.
+          </Note>
+        ) : (
+          <div className="space-y-3">
+            <div className="flex flex-wrap items-center gap-2">
+              <Button size="sm" className="gap-1.5" onClick={generate} disabled={loading || !assessment}>
+                {loading ? (
+                  <Loader2 className="size-3.5 animate-spin" />
+                ) : (
+                  <Sparkles className="size-3.5" />
+                )}
+                {mode === "ai" ? "Draft again" : "Draft with AI"}
+              </Button>
+              {mode === "ai" && <Chip tone="success">AI draft</Chip>}
+              {mode === "manual" && <Chip tone="neutral">Manual draft</Chip>}
+              <Button
+                size="sm"
+                variant="ghost"
+                onClick={() => {
+                  setMode("manual");
+                  setDraft("");
+                  setError(null);
+                }}
+              >
+                Write manually
+              </Button>
+            </div>
+
+            {run && (
+              <p className="text-[10.5px] text-muted-foreground">
+                AI response · {run.durationMs} ms ·{" "}
+                {run.responseId ? `reference ${run.responseId}` : run.detail}
+              </p>
+            )}
+
+            {error && (
+              <Note tone="danger">
+                <span className="font-medium">The draft could not be generated.</span> {error} You
+                can write the update manually; no message will be sent.
+              </Note>
+            )}
+
+            <div className="rounded-lg border border-border/60 bg-muted/20 p-3 text-[11.5px] leading-5">
+              <p className="font-medium">Before you share</p>
+              <p className="text-muted-foreground">
+                Sign-off: {projectState.signOff.status}. Open questions:{" "}
+                {brief.openQuestions.length}. Documents needing an update:{" "}
+                {documentsNeedingUpdate}. The draft must not claim a partner confirmed a document,
+                or that the plan is signed off, unless that is true above.
+              </p>
+            </div>
+
+            <Textarea
+              rows={14}
+              value={draft}
+              onChange={(event) => setDraft(event.target.value)}
+              placeholder={
+                mode === "manual"
+                  ? "Write the client update here. Use only what is recorded in the plan."
+                  : "Draft with AI, then edit every sentence before sharing."
+              }
+              className="font-sans text-[12.5px] leading-6"
+            />
+
+            {draftWarnings.length > 0 && (
+              <Note tone="warning">
+                <span className="font-medium">Review before sharing.</span>
+                <ul className="mt-1 list-disc pl-4">
+                  {draftWarnings.map((warning) => (
+                    <li key={warning}>{warning}</li>
+                  ))}
+                </ul>
+              </Note>
+            )}
+
+            <Note tone="neutral">
+              This draft is unsent. Downloading or copying it is a manual handoff to your own email
+              or client channel; OnCueX does not send it.
+            </Note>
+          </div>
+        )}
+
+        <DialogFooter>
+          <Button variant="outline" size="sm" onClick={() => onOpenChange(false)}>
+            Close
+          </Button>
+          <Button
+            variant="outline"
+            size="sm"
+            className="gap-1.5"
+            disabled={!draft.trim() || draftWarnings.length > 0}
+            onClick={copy}
+          >
+            <Copy className="size-3.5" />
+            {copied ? "Copied" : "Copy draft"}
+          </Button>
+          <Button
+            size="sm"
+            className="gap-1.5"
+            disabled={!draft.trim() || draftWarnings.length > 0}
+            onClick={download}
+          >
+            <Download className="size-3.5" />
+            Download draft
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
