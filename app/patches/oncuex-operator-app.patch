+                >
+                  <Icon className="size-3.5" aria-hidden />
+                  {item.label}
+                  {item.id === "partners" &&
+                    store.evidence.some((record) => record.reviewDisposition === "pending") && (
+                      <span className="ml-0.5 size-1.5 rounded-full bg-warning" aria-hidden />
