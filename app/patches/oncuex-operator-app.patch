+              </p>
+            ) : nextTasks.length > 0 ? (
+              <ul className="space-y-1.5">
+                {nextTasks.map((task) => (
+                  <li
+                    key={task.key}
+                    className="flex items-start gap-2 rounded-lg border border-border/60 px-3 py-2"
