+                </span>
+                <span className="flex items-center gap-1.5">
+                  <Users className="size-3.5" aria-hidden />
+                  {brief.guestCount} guests
+                </span>
+                <span className="flex items-center gap-1.5">
+                  <MapPin className="size-3.5" aria-hidden />
+                  {snapshot.location.venueName}
