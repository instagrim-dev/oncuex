    {
      "id": "V4",
      "area": "readiness",
      "action": "Introduce a cycle in prerequisiteIds, or two prerequisites that cannot both hold. Separately, give the dependent no evidence of its own.",
      "expected": {
        "requirementStatus": "blocked",
        "residualsOrdered": [
          {
            "code": "prerequisite_conflict",
            "primary": true
          },
          {
            "code": "mandatory_evidence_missing",
            "primary": false
          }
        ],
        "countsOnce": true,
        "note": "The conflict leads because it explains why the requirement cannot be satisfied. The evidence residual states what will still need attention once the conflict is resolved. Neither condition clears the other, and the requirement is counted once under its primary status.",
        "cycleAlternative": {
          "code": "prerequisite_cycle",
          "path": "reported"
        }
      }
    },
    {
      "id": "V5",
      "area": "readiness",
      "action": "Give a requirement both conflicting prerequisites and no admissible evidence, then resolve only the conflict, then supply only the evidence.",
      "expected": {
        "statusWhenBoth": "blocked",
        "residualOrder": [
          "prerequisite_conflict",
          "mandatory_evidence_missing"
        ],
        "countedOnce": true,
        "afterResolvingConflict": {
          "conflictResidual": "cleared",
          "evidenceResidual": "remains",
          "status": "not supported"
        },
        "afterSupplyingEvidence": {
          "evidenceResidual": "cleared",
          "conflictLeads": true,
          "status": "blocked"
        },
        "note": "Neither condition clears the other. Totals count the requirement once under its primary status."
      }
    },
